# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (used for magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API Keys). Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for encrypted source secrets, cron sync, and demo reset.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts Canvas tokens and feed URLs at rest.
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Anthropic API key for effort estimation and chat
ANTHROPIC_API_KEY=

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Password for the seeded demo account (demo@sundial.app). Only used server-side by /demo.
DEMO_USER_PASSWORD=

# Optional comma-separated allowlist for magic-link sign-in (recommended on a public deploy)
ALLOWED_EMAILS=
